# Firebase Cloud Functions Configuration
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env or .env.local to version control

# Cloud Functions URL (required for voice agent, TTS, and Stripe)
# Find this in Firebase Console > Functions after deployment
# Format: https://us-central1-{project-id}.cloudfunctions.net
VITE_CLOUD_FUNCTIONS_URL=

# Google Cloud API Key (for fallback TTS)
VITE_GOOGLE_CLOUD_API_KEY=

# Stripe Price IDs (from Stripe Dashboard > Products > Pricing)
# These must match the price IDs in your Stripe product configuration
VITE_STRIPE_BASIC_PRICE_ID=
VITE_STRIPE_PREMIUM_PRICE_ID=
