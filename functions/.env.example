# Firebase Functions runtime (set with `firebase functions:secrets:set` or
# the Functions env UI). NEVER commit real values.
#
# Stripe — required before checkout/portal/webhooks can charge a customer.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_BASIC_MONTHLY_PRICE_ID=
STRIPE_TEST_PREMIUM_MONTHLY_PRICE_ID=
# Live rollout uses STRIPE_MODE=live plus:
# STRIPE_LIVE_BASIC_MONTHLY_PRICE_ID=
# STRIPE_LIVE_PREMIUM_MONTHLY_PRICE_ID=

# Nova realtime speech-to-speech uses OpenAI GPT-Realtime-2.1 and GPT-Transcribe captions.
# OPENAI_API_KEY=
# Separate transcription/enrichment and legacy audio providers:
# GEMINI_API_KEY=
# GOOGLE_CLOUD_API_KEY=

# Optional leftover-agent migration only. Do not set in production
# unless you intend to keep the legacy global agent key.
# AGENT_API_KEY=
# AGENT_USER_ID=
# ALLOW_LEGACY_AGENT_FALLBACK=

# Optional reminder email delivery. Keep these in the server runtime only.
# RESEND_API_KEY=
# REMINDER_EMAIL_FROM=SaveMe <reminders@your-verified-domain.example>
# REMINDER_APP_ORIGIN=https://saveme.space

# Google Calendar / Drive connections. Create a Web application OAuth client.
# Register https://saveme.space/settings as an authorized redirect URI.
# Enable Google Calendar API and Google Drive API in the same project.
# NOVA_GOOGLE_CLIENT_ID=
# NOVA_GOOGLE_CLIENT_SECRET=
