{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "$comment": "SAVE-109: mirrors firebase.emulator.json so a bare `firebase emulators:start` uses the same fixed ports as the CI harness (test/emulator/run.mjs) and docs/hardening/emulator-harness.md §3.1. Emulator-only; production deploys ignore this block. Rules deploys are NOT part of CI/hosting — see docs/deployment-preview.md.",
    "auth": { "port": 9099, "host": "127.0.0.1" },
    "firestore": { "port": 8080, "host": "127.0.0.1" },
    "functions": { "port": 5001, "host": "127.0.0.1" },
    "storage": { "port": 9199, "host": "127.0.0.1" },
    "ui": { "enabled": true, "port": 4000, "host": "127.0.0.1" },
    "singleProjectMode": true
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), payment=(), usb=()" },
          { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/api/extension/pairing-code", "function": "extensionPairingCode" },
      { "source": "/api/extension/pair", "function": "extensionPair" },
      { "source": "/api/extension/refresh", "function": "extensionRefresh" },
      { "source": "/api/extension/revoke", "function": "extensionRevoke" },
      { "source": "/api/extension/revoke-all", "function": "extensionRevokeAll" },
      { "source": "/api/quick-save", "function": "quickSave" },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
