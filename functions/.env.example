# Firebase Functions runtime (set with `firebase functions:secrets:set` or
# the Functions env UI). NEVER commit real values.
#
# Stripe — required before checkout/portal/webhooks can charge a customer.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_BASIC_MONTHLY_PRICE_ID=
STRIPE_TEST_PREMIUM_MONTHLY_PRICE_ID=
# Live rollout uses STRIPE_MODE=live plus:
# STRIPE_LIVE_BASIC_MONTHLY_PRICE_ID=
# STRIPE_LIVE_PREMIUM_MONTHLY_PRICE_ID=

# Nova / audio (required for voice capture, not for Stripe itself)
# GEMINI_API_KEY=
# GOOGLE_CLOUD_API_KEY=

# Optional leftover-agent migration only. Do not set in production
# unless you intend to keep the legacy global agent key.
# AGENT_API_KEY=
# AGENT_USER_ID=
# ALLOW_LEGACY_AGENT_FALLBACK=
