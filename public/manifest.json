{
  "name": "SaveMe.Space",
  "short_name": "SaveMe",
  "description": "Your personal AI knowledge vault. Save anything, find everything, Nova thinks with you.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#030712",
  "theme_color": "#0ea5e9",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/#/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Nova — Quick Capture",
      "short_name": "Capture",
      "description": "Open Nova for instant voice capture",
      "url": "/#/dashboard?nova=open",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Brain Dump",
      "short_name": "Dump",
      "description": "Start a brain dump session",
      "url": "/#/brain-dump",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "All Entries",
      "short_name": "Entries",
      "description": "Browse your vault",
      "url": "/#/all-entries",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "categories": ["productivity", "utilities", "lifestyle"],
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false
}
