# Firebase Cloud Functions Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# ===========================================
# SUPABASE (Legacy - kept for reference)
# ===========================================
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# ===========================================
# FIREBASE CLOUD FUNCTIONS
# ===========================================
# Cloud Functions URL (set after deployment)
# Format: https://us-central1-{project-id}.cloudfunctions.net
VITE_CLOUD_FUNCTIONS_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net

# ===========================================
# STRIPE CONFIGURATION
# ===========================================
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/products
# Create products with monthly recurring prices, then copy the price IDs (price_xxx)
VITE_STRIPE_BASIC_PRICE_ID=price_xxx
VITE_STRIPE_PREMIUM_PRICE_ID=price_xxx

# ===========================================
# FIREBASE FUNCTIONS CONFIG (set via CLI)
# ===========================================
# These are NOT env vars - set them using Firebase CLI:
#
# firebase functions:config:set stripe.secret_key="sk_live_xxx"
# firebase functions:config:set stripe.webhook_secret="whsec_xxx"
# firebase functions:config:set elevenlabs.api_key="xxx"
# firebase functions:config:set google.tts_api_key="xxx"
# firebase functions:config:set openai.api_key="sk-xxx"
# firebase functions:config:set minimax.api_key="xxx"
# firebase functions:config:set minimax.group_id="xxx"
#
# Then deploy functions: firebase deploy --only functions
