# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# Firebase Configuration (required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ElevenLabs TTS (optional - for landing page demo)
VITE_ELEVENLABS_DEMO_API_KEY=

# Cloud Functions URL (set after deployment)
# Format: https://us-central1-{project-id}.cloudfunctions.net
VITE_CLOUD_FUNCTIONS_URL=

# Stripe Price IDs (from your Stripe Dashboard)
VITE_STRIPE_BASIC_PRICE_ID=price_basic_monthly
VITE_STRIPE_PREMIUM_PRICE_ID=price_premium_monthly
