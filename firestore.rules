rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- User-owned data (user_id field) ---
    match /entries/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id;
      allow delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
    }

    match /action_items/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id;
      allow delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
    }

    match /nova_memories/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow write: if false; // server-only writes
    }

    match /nova_conversations/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow write: if false; // server-only writes
    }

    match /nova_user_profile/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // server-only writes
    }

    match /entry_links/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow write: if false; // server-only writes
    }

    match /entry_entities/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow write: if false; // server-only writes
    }

    match /entity_graph/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow write: if false; // server-only writes
    }

    match /user_patterns/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow write: if false; // server-only writes
    }

    match /user_category_patterns/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow write: if false; // server-only writes
    }

    match /reminders/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false; // server-only updates
    }

    match /pending_notifications/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'dismissed';
      allow create, delete: if false; // server-only creates/deletes
    }

    // --- User profile / settings (doc ID = user UID) ---
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Billing entitlement contract is readable by its owner but server-owned.
    match /billing_entitlements/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // billing/plan authority is server-only
    }

    match /entitlement_usage/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // quota ledger is server-only
    }

    // Stripe event ledger is server-only and may contain billing identifiers.
    match /stripe_event_ledger/{eventId} {
      allow read, write: if false;
    }

    match /profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /user_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /search_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /api_keys/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow create, update, delete: if false; // server-only API key writes
    }

    match /shared_memories/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow write: if false; // shared-memory writes go through Cloud Functions
    }

    match /storage_usage/{docId} {
      allow read: if isSignedIn()
        && docId == request.auth.uid
        && resource.data.user_id == request.auth.uid;
      allow create, update, delete: if false; // storage usage writes stay server-owned
    }

    // --- User-generated content ---
    match /search_analytics/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /webhook_events/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /support_tickets/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    // --- Public collections ---
    match /public_demo_videos/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /demo_videos/{docId} {
      // Admin-only writes should be handled server-side
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /waiting_list/{docId} {
      allow create: if true; // public signup
      allow read, update, delete: if false;
    }

    // --- Deny everything else ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
