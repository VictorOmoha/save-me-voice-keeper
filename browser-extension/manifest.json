{
  "manifest_version": 3,
  "name": "SaveMe.Space — Quick Capture",
  "version": "2.0.0",
  "description": "Save anything from the web to your personal vault instantly. One shortcut, zero friction.",
  "permissions": [
    "commands",
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "*://saveme.space/*",
    "*://saveme-f5af0.web.app/*",
    "*://us-central1-saveme-f5af0.cloudfunctions.net/*",
    "*://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://saveme.space/*",
        "*://saveme-f5af0.web.app/*",
        "*://localhost/*"
      ],
      "run_at": "document_idle",
      "js": ["content-script.js"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Quick save to SaveMe.Space vault"
    },
    "brain-dump": {
      "suggested_key": {
        "default": "Ctrl+Space",
        "mac": "Command+Space"
      },
      "description": "Open Nova Brain Dump"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
