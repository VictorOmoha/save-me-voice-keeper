rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Object names are deliberately restricted to one safe path segment. Exact
    // match shapes below reject empty segments and unexpected extra nesting;
    // this helper rejects backslashes and traversal-shaped names.
    function isSafeSegment(segment) {
      return segment.matches('^[A-Za-z0-9][A-Za-z0-9._ -]*$')
        && !segment.matches('.*\\.\\..*')
        && segment != '.'
        && segment != '..';
    }

    function isImage() {
      return request.resource.contentType.matches(
        '^image/(jpeg|png|gif|webp|avif|svg\\+xml)$'
      );
    }

    function isDocument() {
      return request.resource.contentType.matches(
        '^(application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\.(wordprocessingml\\.document|spreadsheetml\\.sheet|presentationml\\.presentation)|application/vnd\\.ms-(excel|powerpoint)|application/vnd\\.oasis\\.opendocument\\.(text|spreadsheet|presentation)|text/plain|text/markdown|text/x-markdown|text/csv|application/json|application/rtf|text/rtf|application/zip|application/x-zip-compressed|audio/[-+.A-Za-z0-9]+|video/[-+.A-Za-z0-9]+)$'
      );
    }

    function imageWriteIsValid() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && isImage();
    }

    function documentWriteIsValid() {
      return request.resource != null
        && request.resource.size <= 25 * 1024 * 1024
        && isDocument();
    }

    function legacyWriteIsValid() {
      return request.resource != null
        && request.resource.size <= 25 * 1024 * 1024;
    }

    // Current image contract: images/{uid}/{fileName}.
    match /images/{userId}/{fileName} {
      allow read, delete: if isOwner(userId) && isSafeSegment(fileName);
      allow create, update: if isOwner(userId)
        && isSafeSegment(fileName)
        && imageWriteIsValid();
    }

    // Current document contract: documents/{uid}/{entryId}/{fileName}.
    match /documents/{userId}/{entryId}/{fileName} {
      allow read, delete: if isOwner(userId)
        && isSafeSegment(entryId)
        && isSafeSegment(fileName);
      allow create, update: if isOwner(userId)
        && isSafeSegment(entryId)
        && isSafeSegment(fileName)
        && documentWriteIsValid();
    }

    // Legacy user-scoped contract: users/{uid}/{fileName}.
    match /users/{userId}/{fileName} {
      allow read, delete: if isOwner(userId) && isSafeSegment(fileName);
      allow create, update: if isOwner(userId)
        && isSafeSegment(fileName)
        && legacyWriteIsValid();
    }

    // Public demo assets are provisioned only by trusted Admin SDK code.
    match /demo-videos/{fileName} {
      allow read: if isSafeSegment(fileName);
      allow write: if false;
    }

    // Optional public assets use the same Admin-SDK-only write boundary.
    match /admin-public/{fileName} {
      allow read: if isSafeSegment(fileName);
      allow write: if false;
    }

    // Deny every path not explicitly covered above, including malformed or
    // over-nested variants of otherwise recognized prefixes.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
