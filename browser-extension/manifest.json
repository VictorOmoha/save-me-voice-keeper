{
  "manifest_version": 3,
  "name": "SaveMe Voice Keeper",
  "version": "1.0.0",
  "description": "Global hotkey for instant brain dump capture",
  "permissions": [
    "commands",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "*://saveme-f5af0.web.app/*",
    "*://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://saveme-f5af0.web.app/*",
        "*://localhost/*"
      ],
      "run_at": "document_start",
      "js": ["content-script.js"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Space",
        "mac": "Command+Space"
      },
      "description": "Open SaveMe Brain Dump"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
